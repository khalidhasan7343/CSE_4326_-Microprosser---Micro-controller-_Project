# Copy this file to .env. Keep real values out of Git.
# Firebase web settings are published to the browser; never put server secrets here.
FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=replace-with-your-sender-id
FIREBASE_APP_ID=replace-with-your-web-app-id

# Used only for the ESP32 firmware; never included in the website configuration.
WIFI_SSID="your-wifi-name"
WIFI_PASS="your-wifi-password"
